Dialogue: 0,0:00:02.04,0:00:06.93,vietsub,,0,0,0,,Từng lời từng câu người nói đều làm lòng em gợn sóng.
Dialogue: 0,0:00:11.13,0:00:15.29,vietsub,,0,0,0,,Cảm xúc không muốn nhường ai, cùng những giọt lệ.
Dialogue: 0,0:00:15.29,0:00:19.56,vietsub,,0,0,0,,Rõ ràng đã quen với cô đơn rồi, vậy mà ngay trước mắt em...
Dialogue: 0,0:00:19.56,0:00:24.01,vietsub,,0,0,0,,Dưới ánh trăng sáng rực rỡ, bóng hình của người...
Dialogue: 0,0:00:24.01,0:00:28.42,vietsub,,0,0,0,,Như đóa hoa cháy đỏ rực, rung rinh trong gió đêm.
Dialogue: 0,0:00:28.42,0:00:32.46,vietsub,,0,0,0,,Em trao lòng mình cho người có được không?
Dialogue: 0,0:00:32.46,0:00:36.84,vietsub,,0,0,0,,Em tin người có được không?
Dialogue: 0,0:00:36.84,0:00:41.23,vietsub,,0,0,0,,Những bánh răng gọi là định mệnh nối vào nhau,
Dialogue: 0,0:00:41.23,0:00:47.55,vietsub,,0,0,0,,đang mở ra cánh cửa dẫn đến tương lai.
Dialogue: 0,0:00:47.55,0:00:52.37,vietsub,,0,0,0,,Từng lời từng câu người nói đều làm lòng em gợn sóng.
Dialogue: 0,0:00:52.37,0:00:56.48,vietsub,,0,0,0,,Giọng nói ngọt ngào ngát hương ấy ôm trọn lấy em.
Dialogue: 0,0:00:56.48,0:01:01.04,vietsub,,0,0,0,,Từng phút từng giây bên nhau, dây đàn trong tim càng căng lên.
Dialogue: 0,0:01:01.04,0:01:03.37,vietsub,,0,0,0,,Thanh âm vang lên khi người khẽ chạm vào...
Dialogue: 0,0:01:03.37,0:01:08.64,vietsub,,0,0,0,,chắc đó là tình yêu rồi.
Dialogue: 0,0:01:05.76,0:01:07.93,vietsub - Sao chép,,0,0,0,,Một hai ba bốn, năm sáu bảy.
Dialogue: 0,0:01:07.93,0:01:10.16,vietsub - Sao chép,,0,0,0,,Tám chín mười... cứ thế vang vọng.
Dialogue: 0,0:01:10.16,0:01:12.38,vietsub - Sao chép,,0,0,0,,Một hai ba bốn, năm sáu bảy.
Dialogue: 0,0:01:12.38,0:01:15.03,vietsub - Sao chép,,0,0,0,,Tám chín mười... không ngừng ngân vang.
Dialogue: 0,0:01:18.53,0:01:22.72,vietsub,,0,0,0,,Dù là nơi bình yên nhất, hay là trong giấc ngủ...
Dialogue: 0,0:01:22.72,0:01:27.06,vietsub,,0,0,0,,Ngón tay em không ngừng run rẩy, ánh mắt thì rối bời.
Dialogue: 0,0:01:27.27,0:01:31.79,vietsub,,0,0,0,,Nếu em buông mình mà chìm đắm vào người...
Dialogue: 0,0:01:31.79,0:01:35.97,vietsub,,0,0,0,,Nếu làm thế mà hiểu được dáng hình tình yêu là gì...
Dialogue: 0,0:01:35.97,0:01:40.13,vietsub,,0,0,0,,Em xin trao linh hồn này cho người.
Dialogue: 0,0:01:40.31,0:01:44.81,vietsub,,0,0,0,,Gạt đi mưa to, cản bước gió lớn.
Dialogue: 0,0:01:44.81,0:01:48.85,vietsub,,0,0,0,,Em được người ôm ấp thật dịu dàng,
Dialogue: 0,0:01:49.12,0:01:57.86,vietsub,,0,0,0,,Hãy nắm tay nhau, bước đến thế giới chỉ có đôi ta.
Dialogue: 0,0:02:06.61,0:02:15.26,vietsub,,0,0,0,,Bất chợt rơi xuống, ý nghĩa của giọt nước mắt này, đúng vậy...
Dialogue: 0,0:02:15.26,0:02:19.38,vietsub,,0,0,0,,Chính là, tình cảm, mà người, dành cho em...
Dialogue: 0,0:02:19.38,0:02:24.48,vietsub,,0,0,0,,Đã lấp đầy em và trào dâng mất rồi.
Dialogue: 0,0:02:26.22,0:02:32.17,vietsub,,0,0,0,,Từng lời từng câu từng chữ người nói (mỗi ngày).
Dialogue: 0,0:02:32.17,0:02:37.26,vietsub,,0,0,0,,Đã trở thành nguồn sống để em bước tiếp (cả hôm nay).
Dialogue: 0,0:02:38.93,0:02:43.72,vietsub,,0,0,0,,Đắm mình trong những lời người nói, lồng ngực này lại không ngừng gợn sóng.
Dialogue: 0,0:02:43.72,0:02:47.69,vietsub,,0,0,0,,Giọng nói cuốn hút nhưng có chút xấu tính ấy, lại làm em an lòng.
Dialogue: 0,0:02:47.69,0:02:52.16,vietsub,,0,0,0,,Những lời trên môi người, chạm đến sâu thẳm lòng em.
Dialogue: 0,0:02:52.16,0:02:54.69,vietsub,,0,0,0,,Khúc nhạc rực rỡ đang ngân vang này...
Dialogue: 0,0:02:54.69,0:03:00.17,vietsub,,0,0,0,,chắc hẳn là tình yêu rồi.
Dialogue: 0,0:02:57.21,0:03:00.75,vietsub - Sao chép,,0,0,0,,(Xin người, hãy đón lấy tất cả những gì thuộc về em...)
Dialogue: 0,0:03:00.75,0:03:04.52,vietsub,,0,0,0,,Cùng ngân vang nhé.
Dialogue: 0,0:03:01.57,0:03:05.47,vietsub - Sao chép,,0,0,0,,(Xin người, hãy nhuộm em bằng sắc màu của người...)
Dialogue: 0,0:03:04.74,0:03:09.19,vietsub,,0,0,0,,Đến mãi về sau.
Dialogue: 0,0:03:06.08,0:03:08.36,vietsub - Sao chép,,0,0,0,,(Một hai ba bốn, năm sáu bảy).
Dialogue: 0,0:03:08.36,0:03:10.15,vietsub - Sao chép,,0,0,0,,(Tám chín mười... cứ thế vang vọng).
Dialogue: 0,0:03:10.15,0:03:12.35,vietsub - Sao chép,,0,0,0,,(Một hai ba bốn, năm sáu bảy).
