Dialogue: 0,0:00:03.04,0:00:07.93,vietsub,,0,0,0,,Từng lời từng câu người nói đều làm lòng em gợn sóng.
Dialogue: 0,0:00:12.13,0:00:16.29,vietsub,,0,0,0,,Cảm xúc không muốn nhường ai, cùng những giọt lệ.
Dialogue: 0,0:00:16.29,0:00:20.56,vietsub,,0,0,0,,Rõ ràng đã quen với cô đơn rồi, vậy mà ngay trước mắt em...
Dialogue: 0,0:00:20.56,0:00:25.01,vietsub,,0,0,0,,Dưới ánh trăng sáng rực rỡ, bóng hình của người...
Dialogue: 0,0:00:25.01,0:00:29.42,vietsub,,0,0,0,,Như đóa hoa cháy đỏ rực, rung rinh trong gió đêm.
Dialogue: 0,0:00:29.42,0:00:33.46,vietsub,,0,0,0,,Em trao lòng mình cho người có được không?
Dialogue: 0,0:00:33.46,0:00:37.84,vietsub,,0,0,0,,Em tin người có được không?
Dialogue: 0,0:00:37.84,0:00:42.23,vietsub,,0,0,0,,Những bánh răng gọi là định mệnh nối vào nhau,
Dialogue: 0,0:00:42.23,0:00:48.55,vietsub,,0,0,0,,đang mở ra cánh cửa dẫn đến tương lai.
Dialogue: 0,0:00:48.55,0:00:53.37,vietsub,,0,0,0,,Từng lời từng câu người nói đều làm lòng em gợn sóng.
Dialogue: 0,0:00:53.37,0:00:57.48,vietsub,,0,0,0,,Giọng nói ngọt ngào ngát hương ấy ôm trọn lấy em.
Dialogue: 0,0:00:57.48,0:01:02.04,vietsub,,0,0,0,,Từng phút từng giây bên nhau, dây đàn trong tim càng căng lên.
Dialogue: 0,0:01:02.04,0:01:04.37,vietsub,,0,0,0,,Thanh âm vang lên khi người khẽ chạm vào...
Dialogue: 0,0:01:04.37,0:01:09.64,vietsub,,0,0,0,,chắc đó là tình yêu rồi.
Dialogue: 0,0:01:06.76,0:01:08.93,vietsub - Sao chép,,0,0,0,,Một hai ba bốn, năm sáu bảy.
Dialogue: 0,0:01:08.93,0:01:11.16,vietsub - Sao chép,,0,0,0,,Tám chín mười... cứ thế vang vọng.
Dialogue: 0,0:01:11.16,0:01:13.38,vietsub - Sao chép,,0,0,0,,Một hai ba bốn, năm sáu bảy.
Dialogue: 0,0:01:13.38,0:01:16.03,vietsub - Sao chép,,0,0,0,,Tám chín mười... không ngừng ngân vang.
Dialogue: 0,0:01:19.53,0:01:23.72,vietsub,,0,0,0,,Dù là nơi bình yên nhất, hay là trong giấc ngủ...
Dialogue: 0,0:01:23.72,0:01:28.06,vietsub,,0,0,0,,Ngón tay em không ngừng run rẩy, ánh mắt thì rối bời.
Dialogue: 0,0:01:28.27,0:01:32.79,vietsub,,0,0,0,,Nếu em buông mình mà chìm đắm vào người...
Dialogue: 0,0:01:32.79,0:01:36.97,vietsub,,0,0,0,,Nếu làm thế mà hiểu được dáng hình tình yêu là gì...
Dialogue: 0,0:01:36.97,0:01:41.13,vietsub,,0,0,0,,Em xin trao linh hồn này cho người.
Dialogue: 0,0:01:41.31,0:01:45.81,vietsub,,0,0,0,,Gạt đi mưa to, cản bước gió lớn.
Dialogue: 0,0:01:45.81,0:01:49.85,vietsub,,0,0,0,,Em được người ôm ấp thật dịu dàng,
Dialogue: 0,0:01:50.12,0:01:58.86,vietsub,,0,0,0,,Hãy nắm tay nhau, bước đến thế giới chỉ có đôi ta.
Dialogue: 0,0:02:07.61,0:02:16.26,vietsub,,0,0,0,,Bất chợt rơi xuống, ý nghĩa của giọt nước mắt này, đúng vậy...
Dialogue: 0,0:02:16.26,0:02:20.38,vietsub,,0,0,0,,Chính là, tình cảm, mà người, dành cho em...
Dialogue: 0,0:02:20.38,0:02:25.48,vietsub,,0,0,0,,Đã lấp đầy em và trào dâng mất rồi.
Dialogue: 0,0:02:27.22,0:02:33.17,vietsub,,0,0,0,,Từng lời từng câu từng chữ người nói (mỗi ngày).
Dialogue: 0,0:02:33.17,0:02:38.26,vietsub,,0,0,0,,Đã trở thành nguồn sống để em bước tiếp (cả hôm nay).
Dialogue: 0,0:02:39.93,0:02:44.72,vietsub,,0,0,0,,Đắm mình trong những lời người nói, lồng ngực này lại không ngừng gợn sóng.
Dialogue: 0,0:02:44.72,0:02:48.69,vietsub,,0,0,0,,Giọng nói cuốn hút nhưng có chút xấu tính ấy, lại làm em an lòng.
Dialogue: 0,0:02:48.69,0:02:53.16,vietsub,,0,0,0,,Những lời trên môi người, chạm đến sâu thẳm lòng em.
Dialogue: 0,0:02:53.16,0:02:55.69,vietsub,,0,0,0,,Khúc nhạc rực rỡ đang ngân vang này...
Dialogue: 0,0:02:55.69,0:03:01.17,vietsub,,0,0,0,,chắc hẳn là tình yêu rồi.
Dialogue: 0,0:02:58.21,0:03:01.75,vietsub - Sao chép,,0,0,0,,(Xin người, hãy đón lấy tất cả những gì thuộc về em...)
Dialogue: 0,0:03:01.75,0:03:05.52,vietsub,,0,0,0,,Cùng ngân vang nhé.
Dialogue: 0,0:03:02.57,0:03:06.47,vietsub - Sao chép,,0,0,0,,(Xin người, hãy nhuộm em bằng sắc màu của người...)
Dialogue: 0,0:03:05.74,0:03:10.19,vietsub,,0,0,0,,Đến mãi về sau.
Dialogue: 0,0:03:07.08,0:03:09.36,vietsub - Sao chép,,0,0,0,,(Một hai ba bốn, năm sáu bảy).
Dialogue: 0,0:03:09.36,0:03:11.15,vietsub - Sao chép,,0,0,0,,(Tám chín mười... cứ thế vang vọng).
