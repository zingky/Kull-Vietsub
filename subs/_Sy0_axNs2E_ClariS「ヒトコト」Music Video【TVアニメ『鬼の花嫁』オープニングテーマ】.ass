Dialogue: 0,0:00:01.34,0:00:06.23,vietsub,,0,0,0,,Từng lời từng câu người nói đều làm lòng em gợn sóng.
Dialogue: 0,0:00:10.43,0:00:14.59,vietsub,,0,0,0,,Cảm xúc không muốn nhường ai, cùng những giọt lệ.
Dialogue: 0,0:00:14.59,0:00:18.86,vietsub,,0,0,0,,Rõ ràng đã quen với cô đơn rồi, vậy mà ngay trước mắt em...
Dialogue: 0,0:00:18.86,0:00:23.31,vietsub,,0,0,0,,Dưới ánh trăng sáng rực rỡ, bóng hình của người...
Dialogue: 0,0:00:23.31,0:00:27.72,vietsub,,0,0,0,,Như đóa hoa cháy đỏ rực, rung rinh trong gió đêm.
Dialogue: 0,0:00:27.72,0:00:31.76,vietsub,,0,0,0,,Em trao lòng mình cho người có được không?
Dialogue: 0,0:00:31.76,0:00:36.14,vietsub,,0,0,0,,Em tin người có được không?
Dialogue: 0,0:00:36.14,0:00:40.53,vietsub,,0,0,0,,Những bánh răng gọi là định mệnh nối vào nhau,
Dialogue: 0,0:00:40.53,0:00:46.85,vietsub,,0,0,0,,đang mở ra cánh cửa dẫn đến tương lai.
Dialogue: 0,0:00:46.85,0:00:51.67,vietsub,,0,0,0,,Từng lời từng câu người nói đều làm lòng em gợn sóng.
Dialogue: 0,0:00:51.67,0:00:55.78,vietsub,,0,0,0,,Giọng nói ngọt ngào ngát hương ấy ôm trọn lấy em.
Dialogue: 0,0:00:55.78,0:01:00.34,vietsub,,0,0,0,,Từng phút từng giây bên nhau, dây đàn trong tim càng căng lên.
Dialogue: 0,0:01:00.34,0:01:02.67,vietsub,,0,0,0,,Thanh âm vang lên khi người khẽ chạm vào...
Dialogue: 0,0:01:02.67,0:01:07.94,vietsub,,0,0,0,,chắc đó là tình yêu rồi.
Dialogue: 0,0:01:05.06,0:01:07.23,vietsub - Sao chép,,0,0,0,,Một hai ba bốn, năm sáu bảy.
Dialogue: 0,0:01:07.23,0:01:09.46,vietsub - Sao chép,,0,0,0,,Tám chín mười... cứ thế vang vọng.
Dialogue: 0,0:01:09.46,0:01:11.68,vietsub - Sao chép,,0,0,0,,Một hai ba bốn, năm sáu bảy.
Dialogue: 0,0:01:11.68,0:01:14.33,vietsub - Sao chép,,0,0,0,,Tám chín mười... không ngừng ngân vang.
Dialogue: 0,0:01:17.83,0:01:22.02,vietsub,,0,0,0,,Dù là nơi bình yên nhất, hay là trong giấc ngủ...
Dialogue: 0,0:01:22.02,0:01:26.36,vietsub,,0,0,0,,Ngón tay em không ngừng run rẩy, ánh mắt thì rối bời.
Dialogue: 0,0:01:26.57,0:01:31.09,vietsub,,0,0,0,,Nếu em buông mình mà chìm đắm vào người...
Dialogue: 0,0:01:31.09,0:01:35.27,vietsub,,0,0,0,,Nếu làm thế mà hiểu được dáng hình tình yêu là gì...
Dialogue: 0,0:01:35.27,0:01:39.43,vietsub,,0,0,0,,Em xin trao linh hồn này cho người.
Dialogue: 0,0:01:39.61,0:01:44.11,vietsub,,0,0,0,,Gạt đi mưa to, cản bước gió lớn.
Dialogue: 0,0:01:44.11,0:01:48.15,vietsub,,0,0,0,,Em được người ôm ấp thật dịu dàng,
Dialogue: 0,0:01:48.42,0:01:57.16,vietsub,,0,0,0,,Hãy nắm tay nhau, bước đến thế giới chỉ có đôi ta.
Dialogue: 0,0:02:05.91,0:02:14.56,vietsub,,0,0,0,,Bất chợt rơi xuống, ý nghĩa của giọt nước mắt này, đúng vậy...
Dialogue: 0,0:02:14.56,0:02:18.68,vietsub,,0,0,0,,Chính là, tình cảm, mà người, dành cho em...
Dialogue: 0,0:02:18.68,0:02:23.78,vietsub,,0,0,0,,Đã lấp đầy em và trào dâng mất rồi.
Dialogue: 0,0:02:25.52,0:02:31.47,vietsub,,0,0,0,,Từng lời từng câu từng chữ người nói (mỗi ngày).
Dialogue: 0,0:02:31.47,0:02:36.56,vietsub,,0,0,0,,Đã trở thành nguồn sống để em bước tiếp (cả hôm nay).
Dialogue: 0,0:02:38.23,0:02:43.02,vietsub,,0,0,0,,Đắm mình trong những lời người nói, lồng ngực này lại không ngừng gợn sóng.
Dialogue: 0,0:02:43.02,0:02:46.99,vietsub,,0,0,0,,Giọng nói cuốn hút nhưng có chút xấu tính ấy, lại làm em an lòng.
Dialogue: 0,0:02:46.99,0:02:51.46,vietsub,,0,0,0,,Những lời trên môi người, chạm đến sâu thẳm lòng em.
Dialogue: 0,0:02:51.46,0:02:53.99,vietsub,,0,0,0,,Khúc nhạc rực rỡ đang ngân vang này...
Dialogue: 0,0:02:53.99,0:02:59.47,vietsub,,0,0,0,,chắc hẳn là tình yêu rồi.
Dialogue: 0,0:02:56.51,0:03:00.05,vietsub - Sao chép,,0,0,0,,(Xin người, hãy đón lấy tất cả những gì thuộc về em...)
Dialogue: 0,0:03:00.05,0:03:03.82,vietsub,,0,0,0,,Cùng ngân vang nhé.
Dialogue: 0,0:03:00.87,0:03:04.77,vietsub - Sao chép,,0,0,0,,(Xin người, hãy nhuộm em bằng sắc màu của người...)
Dialogue: 0,0:03:04.04,0:03:08.49,vietsub,,0,0,0,,Đến mãi về sau.
Dialogue: 0,0:03:05.38,0:03:07.66,vietsub - Sao chép,,0,0,0,,(Một hai ba bốn, năm sáu bảy).
