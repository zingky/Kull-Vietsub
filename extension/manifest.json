{
  "manifest_version": 3,
  "name": "YouTube Aegisub Loader v8.0 (VLC Core)",
  "version": "8.0",
  "permissions": ["storage", "activeTab", "scripting", "unlimitedStorage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.github.com/repos/zingky/Kull-Vietsub/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Mở Menu Sub" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["lib/subtitles-octopus.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": [
        "vnf-comic-sans.ttf",
        "lib/subtitles-octopus-worker.js",
        "lib/subtitles-octopus-worker.wasm",
        "lib/subtitles-octopus-worker-legacy.js"
    ],
    "matches": ["https://www.youtube.com/*"]
  }]
}